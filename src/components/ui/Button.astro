---
// The single call-to-action style used across the site.
interface Props {
  href: string;
  label: string;
  /** Shorter label shown on narrow phones. */
  short?: string;
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  magnetic?: boolean;
  class?: string;
}
const { href, label, short, size = 'md', external = false, magnetic = false, class: cls = '' } = Astro.props;
const sizeClass = size === 'md' ? '' : `btn-${size}`;
---

<a
  href={href}
  class:list={['btn', sizeClass, cls]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  data-magnetic={magnetic ? '' : undefined}
>
  {
    short ? (
      <>
        <span class="sm:hidden">{short}</span>
        <span class="hidden sm:inline">{label}</span>
      </>
    ) : (
      <span>{label}</span>
    )
  }
  <svg class="btn-arrow" width="18" height="10" viewBox="0 0 18 10" aria-hidden="true" focusable="false">
    <path d="M0 5h16.5M12.5 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2"></path>
  </svg>
</a>
