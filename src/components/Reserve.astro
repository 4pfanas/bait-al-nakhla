---
import type { Lang } from '../data/site';
import { site, whatsappLink } from '../data/site';
import type { Content } from '../data/content';
import Eyebrow from './ui/Eyebrow.astro';
import Button from './ui/Button.astro';
import SmartImage from './ui/SmartImage.astro';

interface Props {
  lang: Lang;
  c: Content;
}
const { lang, c } = Astro.props;
const r = c.reserve;
const words = r.title.split(' ');
---

<section
  id="reserve"
  class="relative isolate overflow-hidden pb-28 pt-20 md:pb-40 md:pt-28 lg:pb-48 lg:pt-36"
  aria-labelledby="reserve-title"
  data-reserve
>
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <!-- Mirrored in English so the warm lights sit beside the details, away from the headline. -->
    <div class="h-full w-full ltr:-scale-x-100">
      <div class="h-full w-full opacity-40" data-reserve-bg>
        <SmartImage name="reserve-bg" alt="" sizes="100vw" />
      </div>
    </div>
    <div class="absolute inset-0 bg-ink/55"></div>
    <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-coal to-transparent"></div>
  </div>

  <div class="container-x grid gap-16 lg:grid-cols-12 lg:items-end lg:gap-10">
    <div class="lg:col-span-7">
      <Eyebrow data-fade>{r.eyebrow}</Eyebrow>
      <h2 id="reserve-title" class="t-display mt-6 text-[clamp(3rem,9vw,7.25rem)] leading-[0.98] text-sand rtl:leading-[1.4]">
        <span class="sr-only">{r.title}</span>
        <span aria-hidden="true">
          {
            words.map((w) => (
              <>
                <span class="inline-block overflow-hidden pb-[0.1em] align-bottom">
                  <span class="inline-block" data-reserve-word>
                    {w}
                  </span>
                </span>{' '}
              </>
            ))
          }
        </span>
      </h2>
      <p class="t-body mt-6 max-w-md md:mt-8" data-fade>{r.sub}</p>
      <div class="mt-12 md:mt-14" data-fade>
        <span class="pulse-ring relative inline-flex">
          <Button href={whatsappLink(lang)} label={c.cta.whatsapp} size="lg" external magnetic />
        </span>
      </div>
    </div>

    <dl class="border-t border-line lg:col-span-4 lg:col-start-9" data-fade>
      <div class="grid grid-cols-[6.5rem_1fr] items-baseline gap-4 border-b border-line py-6">
        <dt class="t-eyebrow text-mute">{r.hoursLabel}</dt>
        <dd class="t-body text-sand">{r.hours}</dd>
      </div>
      <div class="grid grid-cols-[6.5rem_1fr] items-baseline gap-4 border-b border-line py-6">
        <dt class="t-eyebrow text-mute">{r.locationLabel}</dt>
        <dd class="t-body text-sand">
          <a href={site.mapsUrl} target="_blank" rel="noopener" class="link-line">{r.location}</a>
        </dd>
      </div>
    </dl>
  </div>
</section>
